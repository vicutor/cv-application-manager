# Copy to .env (repo root) and fill in. Never commit .env -- it's git-ignored already.

# --- App ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Data ---
# Paths are relative to the backend/ working directory (where uvicorn/alembic/pytest run).
DATA_DIR=../data
DATABASE_URL=sqlite:///../data/app.db

# --- LaTeX ---
LATEX_COMPILER=xelatex
LATEX_TIMEOUT_SECONDS=60
LATEX_MAX_REPAIR_ATTEMPTS=5
LATEX_MAX_PAGES=2

# --- LLM provider ---
# Leave ANTHROPIC_API_KEY blank to run the deterministic mock pipeline (no LLM
# calls, no cost, useful for local dev/testing). Set it to enable the real
# Claude-powered pipeline (CV generation, cover letters, bulk import matching).
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_COMPATIBLE_BASE_URL=

# Per-stage model overrides (optional; these are the defaults if left blank)
LLM_MODEL_ANALYSIS=claude-haiku-4-5
LLM_MODEL_MATCHING=claude-sonnet-5
LLM_MODEL_DRAFTING=claude-sonnet-5
LLM_MODEL_FACT_CHECK=claude-sonnet-5
LLM_MODEL_ATS=claude-haiku-4-5
LLM_MODEL_STYLE=claude-sonnet-5

# --- Cost / safety limits ---
# Advisory cap surfaced in the usage dashboard -- not a hard cutoff.
MAX_GENERATION_COST_USD=1.00

# --- Fetching (job-board import) ---
HTTP_USER_AGENT=cv-application-manager/0.1 (+local)
HTTP_TIMEOUT_SECONDS=15
